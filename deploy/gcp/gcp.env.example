# Copy to deploy/gcp/.env.gcp (git-ignored) and fill in. Every script in deploy/gcp reads it.

PROJECT_ID=elearning-gcp-demo-12345
# Jakarta: closest to Indonesian schools, and keeps student data in the country.
REGION=asia-southeast2
ZONE=asia-southeast2-a

# Public hostname. Point an A record at the static IP printed by 30-vm.sh before running certbot.
DOMAIN=elearning.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Compute Engine VM (Docker Compose host). e2-medium: 2 vCPU (shared), 4 GB.
VM_NAME=elearning-vm
VM_MACHINE_TYPE=e2-medium

# Cloud SQL for PostgreSQL. db-g1-small is shared-core (cheap, no SLA); db-custom-1-3840 is dedicated.
SQL_INSTANCE=elearning-db
SQL_TIER=db-g1-small
SQL_DATABASE=elearning
SQL_USER=elearning

# Artifact Registry repository for the backend and frontend images
AR_REPO=elearning

# Exam result e-mails (Cloud Run function). The SMTP password is asked for by 40-functions.sh and
# stored in Secret Manager. Port 25 is blocked on Google Cloud: use 587 (STARTTLS) or 465 (TLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_FROM="E-Learning <notifications@example.com>"
