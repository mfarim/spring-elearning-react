{
  "name": "upload-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Run function: quarantines uploads whose content does not match their extension (Cloud Storage trigger).",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "functions-framework --target=uploadInspector --signature-type=cloudevent",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/storage": "^7.12.0"
  }
}
