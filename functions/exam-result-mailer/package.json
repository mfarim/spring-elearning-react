{
  "name": "exam-result-mailer",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Run function: e-mails students when their exam result is final (Pub/Sub trigger).",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "functions-framework --target=examResultMailer --signature-type=cloudevent",
    "test": "node --test"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.0",
    "@google-cloud/storage": "^7.12.0",
    "nodemailer": "^6.9.14"
  }
}
