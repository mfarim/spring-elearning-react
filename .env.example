# ==============================================================================
# Production Environment Variables Example
# Copy this file to .env and adjust values for production deployment
# ==============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_DB=elearning
POSTGRES_USER=elearning_user
# Generate a strong password: openssl rand -hex 16
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_in_production

# --- JWT Secret Configuration ---
# Must be a 256-bit Base64-encoded secret key!
# Generate using: openssl rand -base64 32
JWT_SECRET=change_this_to_a_secure_base64_256bit_secret_key_in_production

# --- Storage Configuration ---
STORAGE_UPLOAD_DIR=/app/storage/uploads

# --- Host Port Bindings (internal loopback only) ---
FRONTEND_PORT=8088
BACKEND_PORT=8080

# --- CORS Allowed Origins (Comma-separated origins or domain patterns) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://spring-elearning.mfarim.com,http://spring-elearning.mfarim.com,https://*.mfarim.com

# --- Web Analytics (Umami / Google Analytics 4) ---
# Umami Analytics (Self-hosted, privacy-focused analytics):
# Example: https://analytics.example.com/script.js
VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Analytics 4 (Optional, format: G-XXXXXXXXXX):
VITE_GA_MEASUREMENT_ID=
