# ==============================================================================
# Frontend Environment Variables Example (.env)
# ==============================================================================

# --- Umami Analytics (Optional) ---
# Example: <script defer src="https://analytics.example.com/script.js" data-website-id="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"></script>
VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Google Analytics 4 (Optional) ---
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
